<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Senza questa autorizzazione iOS rifiuta la registrazione alle push.
	     Il valore resta "development": in fase di archiviazione per l'App
	     Store la firma automatica lo sostituisce con "production". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
